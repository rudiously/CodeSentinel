{
  "name": "codesentinel-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3002",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "test": "vitest run"
  },
  "dependencies": { "react": "19.1.0", "react-dom": "19.1.0", "recharts": "2.15.3" },
  "devDependencies": {
    "@eslint/js": "9.28.0", "@testing-library/jest-dom": "6.6.3", "@testing-library/react": "16.3.0",
    "@types/react": "19.1.6", "@types/react-dom": "19.1.5", "@vitejs/plugin-react": "4.5.1",
    "eslint": "9.28.0", "globals": "16.2.0", "jsdom": "26.1.0", "prettier": "3.5.3",
    "typescript": "5.8.3", "typescript-eslint": "8.33.0", "vite": "6.3.5", "vitest": "3.2.1",
    "tailwindcss": "3.4.17", "postcss": "8.5.4", "autoprefixer": "10.4.21"
  }
}

# Never commit .env or credentials.
MODEL_ARTIFACT_DIR=models/codesentinel-codebert/v1
MODEL_SERVICE_URL=http://127.0.0.1:8001
MAX_CODE_CHARS=100000
MAX_BATCH_SIZE=32
ENVIRONMENT=development
DEV_LOGIN_ENABLED=false
CORS_ORIGINS=["http://localhost:3002"]
# Set a strong random secret before enabling authentication.
JWT_SECRET=
GITHUB_WEBHOOK_SECRET=
MAX_REQUEST_BYTES=1000000
MODEL_TIMEOUT_SECONDS=10
MAX_FILES=50
MAX_FUNCTIONS=200
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Explicit offline alternatives; defaults use tree-sitter and external scanners.
ALLOW_PYTHON_AST=false
STATIC_ANALYSIS_MODE=external
RISK_MODEL_WEIGHT=0.5
RISK_STATIC_WEIGHT=0.5
RISK_AGREEMENT_BONUS=0.1
RISK_WARN_THRESHOLD=0.35
RISK_BLOCK_THRESHOLD=0.65
DATABASE_URL=sqlite:///codesentinel.db
# Session auth is required by default. Production rejects dev login or disabled auth.
AUTH_REQUIRED=true
JWT_EXPIRY_MINUTES=60
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
GITHUB_ALLOWED_USER_IDS=[]
FRONTEND_URL=http://localhost:3002
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=0
GITHUB_APP_PRIVATE_KEY=
# Frontend build-time settings; mocks are visibly SYNTHETIC.
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=false
# Required local Compose secrets. Use independent random values; URL-encode DB password in DATABASE_URL if running outside Compose.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
MODEL_VERSION=codesentinel-codebert/v1
# Set 0 to disable attribution; 8 integration steps by default (latency trade-off).
EXPLAIN_STEPS=8
SCAN_TIMEOUT_SECONDS=60
# Primary gate: GitHub-provided OIDC plus GITHUB_TOKEN; no stored session token required.
GITHUB_OIDC_ENABLED=false
GITHUB_ALLOWED_REPOSITORIES=["rudiously/CodeSentinel"]
GITHUB_OIDC_AUDIENCE=codesentinel
VITE_MLFLOW_URL=http://localhost:5001
